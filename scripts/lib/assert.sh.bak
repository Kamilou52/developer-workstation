#!/usr/bin/env bash

#------------------------------------------------------------------------------
# Assert Library
#
# Toutes les assertions suivent la même convention.
#
# Signature :
#
#     assert_xxx arguments... "Message"
#
# Retour :
#
#     0 -> succès
#     1 -> échec
#
# Chaque assertion :
#
#     - met à jour les compteurs
#     - affiche le résultat
#     - retourne un code d'état
#
#------------------------------------------------------------------------------

# @Name: assert.sh
# @Description: Assertions communes pour les tests.
# @Version: 1.0.0

_assert_result() {

    local status="$1"
    local message="${2:-Assertion}"

    increment_total

    if (( status == 0 ))
    then
        increment_passed
        print_ok "$message"
    else
        increment_failed
        print_error "$message"
    fi

    return "$status"

}

_assert_failure_details() {

    while (( $# > 1 ))
    do
        printf '%-10s: %s\n' "$1" "$2"
        shift 2
    done

}

assert_empty() {

    local value="$1"
    local message="${2:-Value is empty}"

    if [ -z "$value" ]
    then
        _assert_result 0 "$message"
        return 0
    fi

    _assert_result 1 "$message"

    _assert_failure_details \
        "Value" "$value"

    return 1

}

assert_not_empty() {

    local value="$1"
    local message="${2:-Value is not empty}"

    if [ -n "$value" ]
    then
        _assert_result 0 "$message"
        return 0
    fi

    _assert_result 1 "$message"

    echo "Value is empty"

    return 1

}

assert_equals() {

    local expected="$1"
    local actual="$2"
    local message="${3:-Assertion}"

    if [[ "$expected" == "$actual" ]]
    then
	    
         _assert_result 0 "$message"
         return 0
    fi

    _assert_result 1 "$message"

    echo "Expected : $expected"
    echo "Actual   : $actual"

    return 1

}

assert_file_exists() {

    local file="$1"
    local message="${2:-File exists}"

    if [ -f "$file" ]
    then
        _assert_result 0 "$message"
        return 0
    fi

    _assert_result 1 "$message"

    echo "Missing file : $file"

    return 1

}

assert_directory_exists() {

    local directory="$1"
    local message="${2:-Directory exists}"

    if [ -d "$directory" ]
    then
        _assert_result 0 "$message"
        return 0
    fi

    _assert_result 1 "$message"

    echo "Missing directory : $directory"

    return 1

}

assert_true() {

    local command="$1"
    local message="${2:-Assertion}"

    if "$command"
    then
        _assert_result 0 "$message"
        return 0
    fi

    _assert_result 1 "$message"

    return 1

}

assert_false() {

    local command="$1"
    local message="${2:-Assertion}"

    if ! "$command"
    then
        _assert_result 0 "$message"
        return 0
    fi

    _assert_result 1 "$message"

    return 1

}

assert_command_success() {

    local message="${*: -1}"

    if (( $# > 1 ))
    then
        set -- "${@:1:$(($#-1))}"
    else
        message="Command succeeded"
    fi

    if "$@"
    then
        _assert_result 0 "$message"
        return 0
    fi

    _assert_result 1 "$message"

    echo "Command failed : $*"

    return 1

}

assert_command_failure() {

    local message="${*: -1}"

    if (( $# > 1 ))
    then
        set -- "${@:1:$(($#-1))}"
    else
        message="Command failed"
    fi

    if ! "$@"
    then
        _assert_result 0 "$message"
        return 0
    fi

    _assert_result 1 "$message"

    echo "Command unexpectedly succeeded : $*"

    return 1

}

assert_contains() {

    local expected="$1"
    local actual="$2"
    local message="${3:-Assertion}"

    if [[ "$actual" == *"$expected"* ]]
    then
        _assert_result 0 "$message"
        return 0
    fi

    _assert_result 1 "$message"

    echo "Expected to find : $expected"
    echo "In               : $actual"

    return 1

}

assert_file_contains() {

    local file="$1"
    local expected="$2"
    local message="${3:-Assertion}"

    if [ ! -f "$file" ]
    then
        _assert_result 1 "$message"

        echo "Missing file : $file"

        return 1
    fi

    if grep -Fq "$expected" "$file"
    then
        _assert_result 0 "$message"
        return 0
    fi

    _assert_result 1 "$message"

    echo "Expected : $expected"
    echo "File     : $file"

    return 1

}
